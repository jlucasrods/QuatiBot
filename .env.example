# Optional: Compose provides defaults when these settings are omitted.
COMPOSE_PROJECT_NAME=quatibot
QUATI_BIND_ADDRESS=127.0.0.1
QUATI_HTTP_PORT=8080
# Leave empty to use http://localhost:${QUATI_HTTP_PORT:-8080}.
QUATI_PUBLIC_URL=
# Leave empty to inherit QUATI_PUBLIC_URL.
QUATI_WEBHOOK_PUBLIC_URL=
# For Tailscale Serve, set the HTTPS hostname (without scheme or path).
# Set QUATI_PUBLIC_URL to https:// followed by the same hostname.
# Requires QUATI_BIND_ADDRESS=127.0.0.1 and a trusted local HTTPS proxy.
QUATI_HTTPS_HOST=
QUATI_BASE_IMAGE=ghcr.io/jlucasrods/quatibot:latest
QUATI_LOCAL_IMAGE=quatibot-local:latest
CADDY_IMAGE=caddy:2
# Explicitly empty ENGINES skips npm engine installation.
ENGINES="@anthropic-ai/claude-code @openai/codex"
# Leave empty for <COMPOSE_PROJECT_NAME>_data.
QUATI_DATA_VOLUME=
# Use true only when reusing a volume that already exists.
QUATI_DATA_EXTERNAL=false
